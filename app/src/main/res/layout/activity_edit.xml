<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/link_label" android:textColor="@color/muted" android:textSize="12sp"/>
        <EditText android:id="@+id/fUrl"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:background="@drawable/bg_input"
            android:hint="@string/link_hint" android:inputType="textUri" android:maxLines="2"
            android:padding="12dp" android:textColor="@color/text"
            android:textColorHint="@color/muted" android:importantForAutofill="no"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/title_label" android:textColor="@color/muted" android:textSize="12sp"/>
        <EditText android:id="@+id/fTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:background="@drawable/bg_input"
            android:hint="@string/title_hint" android:inputType="text" android:maxLines="2"
            android:padding="12dp" android:textColor="@color/text"
            android:textColorHint="@color/muted" android:importantForAutofill="no"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/tag_label" android:textColor="@color/muted" android:textSize="12sp"/>
        <EditText android:id="@+id/fTag"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:background="@drawable/bg_input"
            android:hint="@string/tag_hint" android:inputType="text" android:maxLines="1"
            android:padding="12dp" android:textColor="@color/text"
            android:textColorHint="@color/muted" android:importantForAutofill="no"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/note_label" android:textColor="@color/muted" android:textSize="12sp"/>
        <EditText android:id="@+id/fNote"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:background="@drawable/bg_input"
            android:hint="@string/note_hint" android:inputType="textMultiLine"
            android:minLines="3" android:gravity="top"
            android:padding="12dp" android:textColor="@color/text"
            android:textColorHint="@color/muted" android:importantForAutofill="no"/>

        <Button android:id="@+id/btnSave"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/save"/>

        <Button android:id="@+id/btnOpen"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/open_link"/>

        <Button android:id="@+id/btnDelete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="@string/delete"
            android:textColor="@color/brand"/>
    </LinearLayout>
</ScrollView>
